{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server",
        "--prefix",
        "Game/founding-realm"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "client-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "35315",
        "--bind",
        "127.0.0.1",
        "--directory",
        "Game/founding-realm/public"
      ],
      "port": 35315
    },
    {
      "name": "rebuild",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "Game/founding-realm/rebuild/esbuild.config.mjs",
        "--serve",
        "--port=33446"
      ],
      "port": 33446
    }
  ]
}